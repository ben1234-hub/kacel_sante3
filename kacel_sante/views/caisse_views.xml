<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Action for history.caisse -->
    <record id="action_open_history_caisse" model="ir.actions.act_window">
        <field name="name">Historique de Caisse</field>
        <field name="res_model">history.caisse</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_today': 1}</field>
    </record>

    <record id="view_caisse_search" model="ir.ui.view">
        <field name="name">history.caisse.search</field>
        <field name="model">history.caisse</field>
        <field name="arch" type="xml">
            <search>
                <!-- Fields to search -->
                <field name="date"/>
                <field name="total_amount"/>
                <field name="number_of_appointments"/>

                <!-- Default filter for today's records -->
                <filter string="Aujourd'hui" name="today"
                        domain="[('date', '=', context_today().strftime('%Y-%m-%d'))]"/>
            </search>
        </field>
    </record>

    <!-- Tree View for history.caisse -->
    <record id="view_caisse_tree" model="ir.ui.view">
        <field name="name">history.caisse.tree</field>
        <field name="model">history.caisse</field>
        <field name="arch" type="xml">
            <tree>
                <field name="date"/>
                <field name="number_of_appointments_kinesitherapy"/>
                <field name="number_of_appointments"/>
                <field name="total_amount"/>
            </tree>
        </field>
    </record>

    <!-- Form View for history.caisse -->
    <record id="view_caisse_form" model="ir.ui.view">
        <field name="name">history.caisse.form</field>
        <field name="model">history.caisse</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <h1>
                        <field name="date" readonly="1" class="oe_inline"/>
                    </h1>
                    <group>
                        <field name="total_amount" string="Total"/>
                        <group string="Rendez-vous de Kinésithérapie">
                            <field name="total_kinesitherapy_amount"/>
                            <field name="number_of_appointments_kinesitherapy"/>
                        </group>
                        <group string="Rendez-vous Médical">
                            <field name="total_medical_amount"/>
                            <field name="number_of_appointments"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Détails des RDV Adulte">
                            <field name="kinesitherapy_appointment_ids" readonly="1">
                                <tree>
                                    <field name="name"/>
                                    <field name="appointment_date"/>
                                    <field name="total_selected_amount"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Détails des RDV Medicaux">
                            <field name="appointment_ids" readonly="1">
                                <tree>
                                    <field name="name"/>
                                    <field name="appointment_date"/>
                                    <field name="amount_display" string="Montant" readonly="1"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

</odoo>