<odoo>
    <record id="view_planing_kines_tree" model="ir.ui.view">
    <field name="name">planing.kines.tree</field>
    <field name="model">planing.kines</field>
    <field name="arch" type="xml">
        <tree>
            <field name="name"/>
            <field name="start_date"/>
        </tree>
    </field>
</record>

<record id="view_planing_kines_form" model="ir.ui.view">
    <field name="name">planing.kines.form</field>
    <field name="model">planing.kines</field>
    <field name="arch" type="xml">
        <form>
            <sheet>
                <group>
                    <field name="name"/>
                    <field name="start_date"/>
                </group>
                <notebook>
                    <page string="Planification">
                        <field name="line_ids">
                            <tree editable="bottom">
                                <field name="patient_id" readonly = '1'/>
                                <field name="kinesitherapist_id"/>
                            </tree>
                        </field>
                    </page>
                </notebook>
            </sheet>
        </form>
    </field>
</record>

<record id="action_planing_kines" model="ir.actions.act_window">
    <field name="name">Planning des Kinésithérapeutes</field>
    <field name="res_model">planing.kines</field>
    <field name="view_mode">tree,form</field>
</record>

</odoo>