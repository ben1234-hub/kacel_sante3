<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Tree View for Gestion Abonnement -->
    <record id="view_gestion_abonnement_tree" model="ir.ui.view">
        <field name="name">gestion.abonnement.tree</field>
        <field name="model">gestion.abonnement</field>
        <field name="arch" type="xml">
            <tree decoration-warning="state == 'with_debt'"
                  decoration-danger="state == 'abonnement_end'"
                  decoration-success="state == 'without_debt'">
                <field name="name" optional="hide"/>
                <field name="patient_id"/>
                <field name="date"/>
                <field name="number_of_abonnements"/>
                <field name="state" string="Payment" optional="hide"/>
                <field name="etat" widget="tags" options="{'color_field': 'color'}"/>
                <field name="type_abonnement_id"/>
                <field name="pack_name" />
                <field name="number_of_sessions" optional="hide"/>
                <field name="used_sessions" optional="hide"/>
                <field name="remaining_sessions" optional="hide"/>
                <field name="total_sans_remise" optional="hide"/>
                <field name="total_avec_remise" optional="hide"/>
                <field name="total_verssement" optional="show"/>
                <field name="amount_remaining" optional="show"/>
            </tree>
        </field>
    </record>

    <!-- Form View for Gestion Abonnement -->
    <record id="view_gestion_abonnement_form" model="ir.ui.view">
        <field name="name">gestion.abonnement.form</field>
        <field name="model">gestion.abonnement</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="date"/>
                            <field name="patient_id"/>
                            <field name="sexe"/>
                            <field name="phone" invisible="1"/>
                            <field name="type_abonnement_id"/>
                            <field name="pack_name"/>
                            <field name="number_of_sessions"/>
                            <field name="used_sessions"/>
                            <field name="remaining_sessions"/>
                        </group>
                        <group>
                            <field name="date_debut"/>
                            <field name="date_fin"/>
                            <field name="remise_globale"/>
                            <field name="total_sans_remise"/>
                            <field name="total_avec_remise"/>
                            <field name="total_verssement"/>
                            <field name="amount_remaining"/>
                            <field name="etat"/>
                        </group>
                    </group>
                    <!-- Notebook for Related Versements -->
                    <notebook>
                        <page string="Versements">
                            <field name="verssement_ids">
                                <tree editable="bottom">
                                    <field name="name"/>
                                    <field name="date_verssement"/>
                                    <field name="montant_versse"/>
                                    <field name="rest"/>
                                </tree>
                                <form>
                                    <group>
                                        <field name="name"/>
                                        <field name="date_verssement"/>
                                        <field name="montant_versse"/>
                                        <field name="rest"/>
                                    </group>
                                </form>
                            </field>
                        </page>
                        <page string="Historique des Séances">
                            <field name="intensif_ids" readonly="1">
                                <tree>
                                    <field name="service_intensif_id" string="Séances"/>
                                    <field name="start_date" string="Date de Début"/>
                                    <field name="abonnement_id" string="Abonnement"/>
                                    <field name="pack_name" string="Nom du Pack"/>
                                </tree>
                                <form>
                                    <group>
                                        <field name="service_intensif_id" string="Séances"/>
                                        <field name="start_date" string="Date de Début"/>
                                        <field name="abonnement_id" string="Abonnement"/>
                                        <field name="pack_name" string="Nom du Pack"/>
                                    </group>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View for Gestion Abonnement -->
    <record id="view_gestion_abonnement_search" model="ir.ui.view">
        <field name="name">gestion.abonnement.search</field>
        <field name="model">gestion.abonnement</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="patient_id"/>
                            <!-- Filter for patients with exactly one abonnement -->
                <filter string="Patients avec un seul abonnement"
                    name="single_abonnement"
                    domain="[('number_of_abonnements', '=', 1)]"/>
                <filter string="Today's Records" name="today"
                        domain="[('date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="with_debt"
                        domain="[('state', '=', 'with_debt')]"/>
                <filter name="without_debt"
                        domain="[('state', '=', 'without_debt')]"/>
                <filter name="abonnement_end"
                        domain="[('state', '=', 'abonnement_end')]"/>
                <group expand="0" string="Group By">
                    <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Patient" name="group_patient" context="{'group_by': 'patient_id'}"/>
                    <filter string="Date" name="group_date" context="{'group_by': 'date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action for Gestion Abonnement -->
    <record id="action_open_gestion_abonnement" model="ir.actions.act_window">
        <field name="name">Abonnements</field>
        <field name="res_model">gestion.abonnement</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'default_date': datetime.datetime.now().strftime('%Y-%m-%d')}</field>
    </record>
</odoo>