    <!-- Tree View for Caisse Abonnement -->
    <record id="view_caisse_abonnement_tree" model="ir.ui.view">
        <field name="name">caisse.abonnement.tree</field>
        <field name="model">caisse.abonnement</field>
        <field name="arch" type="xml">
            <tree>
                <field name="date"/>
                <field name="total_amount_paid"/>
                <field name="number_of_verssements"/>
            </tree>
        </field>
    </record>

    <!-- Form View for Caisse Abonnement -->
    <record id="view_caisse_abonnement_form" model="ir.ui.view">
        <field name="name">caisse.abonnement.form</field>
        <field name="model">caisse.abonnement</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <h1>
                        <field name="date" readonly="1" class="oe_inline"/>
                    </h1>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="total_amount_paid" readonly="1"/>
                            <field name="number_of_verssements" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Détails des Abonnements">
                            <field name="verssement_details" readonly="1">
                                <tree>
                                    <field name="name"/>
                                    <field name="patient_id"/>
                                    <field name="pack_name"/>
                                    <field name="montant_versse"/>
                                    <field name="rest"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

