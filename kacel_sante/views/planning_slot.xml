<odoo>
<!-- Planning Slot Tree View -->
<record id="view_planning_slot_tree" model="ir.ui.view">
    <field name="name">planning.slot.tree</field>
    <field name="model">planning.slot</field>
    <field name="arch" type="xml">
        <tree>
            <field name="name"/>
            <field name="day_of_week" widget="selection"/>
            <field name="time_of_day" widget="selection"/>
            <field name="allowed_gender" widget="selection"/>
            <field name="start_time" widget="float_time"/>
            <field name="end_time" widget="float_time"/>
        </tree>
    </field>
</record>

<!-- Planning Slot Form View -->
<record id="view_planning_slot_form" model="ir.ui.view">
    <field name="name">planning.slot.form</field>
    <field name="model">planning.slot</field>
    <field name="arch" type="xml">
        <form>
            <sheet>
                <group>
                    <field name="name"/>
                    <field name="day_of_week"/>
                    <field name="time_of_day"/>
                    <field name="allowed_gender"/>
                    <field name="start_time" widget="float_time"/>
                    <field name="end_time" widget="float_time"/>
                </group>
            </sheet>
        </form>
    </field>
</record>

<!-- Menu et Action -->
<record id="action_planning_slot" model="ir.actions.act_window">
    <field name="name">Gestion des Créneaux</field>
    <field name="res_model">planning.slot</field>
    <field name="view_mode">tree,form</field>
</record>

<menuitem id="menu_planning"
          name="Planning"
          parent="menu_banliotherapie_root"
          action="action_planning_slot"/>
</odoo>