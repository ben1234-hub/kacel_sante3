<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ================================================================ -->
    <!-- MENU PRINCIPAL - Consultation Médicale -->
    <!-- ================================================================ -->
    <menuitem id="menu_root"
              name="Consultation Médicale"
              web_icon="kacel_sante,static/description/Kacel_logo.jpg"
              sequence="10"/>

    <!-- Action for Medical Appointment -->
    <record id="action_medical_appointment" model="ir.actions.act_window">
        <field name="name">Rendez-vous Médicaux</field>
        <field name="res_model">medical.appointment</field>
        <field name="view_mode">calendar,tree,form</field>
        <field name="context">{'search_default_today': 1}</field>
    </record>

    <!-- Menu Item for Medical Appointments -->
    <menuitem id="menu_medical_appointment"
              name="Rendez-vous Médicaux"
              parent="menu_root"
              action="action_medical_appointment"
              sequence="1"/>

    <!-- Menu Item for Patients -->
    <menuitem id="menu_patient_action"
              name="Patients"
              parent="menu_root"
              action="action_patient"
              sequence="2"/>

    <!-- Menu Item for Médecins -->
    <menuitem id="menu_medical_doctor"
              name="Médecins"
              parent="menu_root"
              action="action_medical_doctor"
              sequence="3"/>

    <!-- ================================================================ -->
    <!-- SOUS-MENU: GESTION KINÉSITHÉRAPIE -->
    <!-- ================================================================ -->
    <menuitem id="menu_kinesitherapy_root"
              name="Kinésithérapie"
              parent="menu_root"
              sequence="4"/>

    <!-- Menu Item for Rendez-vous Kinésithérapie -->
    <record id="action_kinesitherapy_appointment" model="ir.actions.act_window">
        <field name="name">Rendez-vous Kinésithérapie</field>
        <field name="res_model">kinesitherapy.appointment</field>
        <field name="view_mode">calendar,tree,form</field>
    </record>

    <menuitem id="menu_kinesitherapy_appointment"
              name="Rendez-vous"
              parent="menu_kinesitherapy_root"
              action="action_kinesitherapy_appointment"
              sequence="1"/>

    <!-- Menu Item for Kinésithérapeutes -->
    <menuitem id="menu_kinesitherapist_action"
              name="Kinésithérapeutes"
              parent="menu_kinesitherapy_root"
              action="action_kinesitherapist"
              sequence="2"/>

    <!-- Menu Item for Planning -->
    <menuitem id="menu_planing_kines_action"
              name="Planning"
              parent="menu_kinesitherapy_root"
              action="action_planing_kines"
              sequence="3"/>

    <!-- Menu Item for Actes de Kinésithérapie -->
    <menuitem id="menu_kinesitherapy_act"
              name="Actes Médicaux"
              parent="menu_kinesitherapy_root"
              action="action_kinesitherapy_act"
              sequence="4"/>

    <!-- ================================================================ -->
    <!-- SOUS-MENU: GESTION ABONNEMENTS ET FINANCIER -->
    <!-- ================================================================ -->
    <menuitem id="menu_financial_root"
              name="Abonnements & Finances"
              parent="menu_root"
              sequence="5"/>

    <!-- Menu Item for Abonnements -->
    <menuitem id="menu_gestion_abonnement"
              name="Gestion des Abonnements"
              parent="menu_financial_root"
              action="action_open_gestion_abonnement"
              sequence="1"/>

    <!-- Menu Item for Caisse Abonnement -->
    <menuitem id="menu_caisse_abonnement"
              name="Caisse Abonnement"
              parent="menu_financial_root"
              action="action_open_caisse_abonnement"
              sequence="2"/>

    <!-- Menu Item for Caisse Médicale -->
    <menuitem id="menu_history_caisse"
              name="Caisse Médicale"
              parent="menu_financial_root"
              groups="kacel_sante.group_kacel_manager,kacel_sante.group_kacel_reception2"
              action="action_open_history_caisse"
              sequence="3"/>

    <!-- ================================================================ -->
    <!-- SOUS-MENU: SERVICES INTENSIFS -->
    <!-- ================================================================ -->
    <menuitem id="menu_service_intensif_root"
              name="Services Intensifs"
              parent="menu_root"
              sequence="6"/>

    <!-- Menu Item for Services Intensifs -->
    <menuitem id="menu_service_intensif"
              name="Services Intensifs"
              parent="menu_service_intensif_root"
              action="action_service_intensif"
              sequence="1"/>

    <!-- Menu Item for Patients (Services Intensifs) -->
    <menuitem id="menu_patient_action_intensif"
              name="Patients"
              groups="kacel_sante.group_kacel_manager,kacel_sante.group_kacel_reception1,kacel_sante.group_kacel_reception2"
              parent="menu_service_intensif_root"
              action="action_patient"
              sequence="2"/>

    <!-- ================================================================ -->
    <!-- SOUS-MENU: CONFIGURATION -->
    <!-- ================================================================ -->
    <menuitem id="menu_configuration"
              name="Configuration"
              parent="menu_root"
              sequence="10"/>

    <!-- Menu Item for Affection -->
    <menuitem id="menu_affiction_configuration"
              name="Affections"
              parent="menu_configuration"
              action="action_affiction"
              sequence="1"/>

    <!-- Menu Item for Actes Patient -->
    <menuitem id="menu_acte_patient_configuration"
              name="Actes Patient"
              parent="menu_configuration"
              action="action_patient_act_session_views"
              sequence="2"/>

    <!-- Menu Item for Configuration Service Intensif -->
    <menuitem id="menu_service_intensif_config_action"
              name="Configuration Services Intensifs"
              parent="menu_configuration"
              action="action_service_intensif_config"
              sequence="3"/>

</odoo>
