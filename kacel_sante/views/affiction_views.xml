<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Action for the Affiction model -->
    <record id="action_affiction" model="ir.actions.act_window">
        <field name="name">Affection</field>
        <field name="res_model">affiction</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Tree view for Affiction -->
    <record id="view_affiction_tree" model="ir.ui.view">
        <field name="name">affiction.tree</field>
        <field name="model">affiction</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="etage"/>
                <field name="description"/>
            </tree>
        </field>
    </record>

    <!-- Form view for Affiction -->
    <record id="view_affiction_form" model="ir.ui.view">
        <field name="name">affiction.form</field>
        <field name="model">affiction</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="etage"/>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

</odoo>