<odoo>
    <record id="view_pay_act_wizard_form" model="ir.ui.view">
        <field name="name">pay.act.wizard.form</field>
        <field name="model">pay.act.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="message" readonly="1"/>
                    </group>
                    <footer>
                        <button name="action_confirm_payment"
                                type="object"
                                string="Payer maintenant"
                                class="btn-primary"/>
                        <button string="Annuler"
                                class="btn-secondary"
                                special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>
</odoo>