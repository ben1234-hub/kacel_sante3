<odoo>
 <record id="view_appointment_details_wizard_form" model="ir.ui.view">
    <field name="name">banliotherapie.appointment.details.wizard.form</field>
    <field name="model">banliotherapie.appointment.details.wizard</field>
    <field name="arch" type="xml">
        <form>
            <header>
                <button string="Fermer" class="btn-primary" special="cancel"/>
            </header>
            <sheet>
                <group>
                    <field name="total_patients" string="Nombre de Patients" readonly="1"/>
                </group>
                <notebook>
                    <page string="Détails des Patients">
                        <field name="patient_line_ids">
                            <tree editable="bottom">
                                <field name="patient_id"/>
                                <field name="phone"/>
                            </tree>
                        </field>
                    </page>
                </notebook>
            </sheet>
        </form>
    </field>
</record>
    <record id="action_open_appointment_details_wizard" model="ir.actions.server">
    <field name="name">Ouvrir Détails du Rendez-vous</field>
    <field name="model_id" ref="model_banliotherapie_appointment"/>
    <field name="binding_model_id" ref="model_banliotherapie_appointment"/>
    <field name="binding_type">action</field>
    <field name="state">code</field>
    <field name="code">
        env['banliotherapie.appointment.details.wizard'].create({'appointment_id': record.id}).with_context({'form_view_initial_mode': 'edit'}).get_formview_action()
    </field>
</record>
</odoo>
