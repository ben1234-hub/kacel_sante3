<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Category -->
        <record model="ir.module.category" id="module_category_kacel_sente">
            <field name="name">Kacel Sente</field>
        </record>

        <!-- Groups -->
        <record id="group_kacel_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="module_category_kacel_sente"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_kacel_reception1" model="res.groups">
            <field name="name">Reception RDC</field>
            <field name="category_id" ref="module_category_kacel_sente"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_kacel_reception2" model="res.groups">
            <field name="name">Reception 1ere</field>
            <field name="category_id" ref="module_category_kacel_sente"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_kacel_doctor" model="res.groups">
            <field name="name">Doctor</field>
            <field name="category_id" ref="module_category_kacel_sente"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>
    </data>
</odoo>