<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--  Appointment card report template -->
    <template id="appointment_card">
                <t t-call="web.html_container">
          <section>
                <div class="header">
                    <!-- Company Logo and Information -->
                    <div class="row">
                        <div class="col-xs-6">
<!--                            <img t-if="company.logo" t-att-src="image_data_uri(company.logo)" style="max-height: 100px;"/>-->
<!--                            <h2 t-if="company.name">Carte Patient - <span t-field="company.name"/></h2>-->
                        </div>
                        <div class="col-xs-6 text-right">
                            <h3>Carte Patient</h3>
                        </div>
                    </div>
                </div>

                <!-- Patient Information -->
                <div class="patient-info">
                    <h3>Informations du Patient</h3>
                    <p><strong>Nom:</strong> <span t-field="doc.patient_id.name"/></p>
                    <p><strong>Âge:</strong> <span t-field="doc.patient_id.age"/></p>
                    <p><strong>Téléphone:</strong> <span t-field="doc.patient_id.phone"/></p>
                </div>

                <!-- Actes and Number of Sessions -->
                <div class="actes-table">
                    <h3>Actes de Kinésithérapie</h3>
                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Heure</th>
                                <th>Acte</th>
                                <th>Montant</th>
                                <th>Nombre de Séances</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="doc.patient_act_session_ids" t-as="act">
                                <td><span t-field="act.create_date" t-options='{"format": "dd/MM/yyyy"}'/></td>
                                <td><span t-field="act.create_date" t-options='{"format": "HH:mm"}'/></td>
                                <td><span t-field="act.act_id.name"/></td>
                                <td><span t-field="act.act_id.amount"/></td>
                                <td><span t-field="act.number_of_sessions"/></td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <!-- Summary: Total Number of Sessions -->
                <div class="summary">
                    <h3>Résumé</h3>
                    <div class="square">
                        <strong>Total Séances:</strong>
                        <span t-esc="sum(act.number_of_sessions for act in doc.patient_act_session_ids)"/>
                    </div>
                </div>
          </section>
        </t>

